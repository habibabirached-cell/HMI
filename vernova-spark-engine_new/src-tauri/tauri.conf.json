{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verona Spark Engine",
  "version": "1.0.0",
  "identifier": "com.veronaspark.engine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Verona Spark Engine",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Verona",
    "copyright": "Copyright 2026 Verona",
    "category": "DeveloperTool",
    "shortDescription": "Verona Spark Engine SCADA and Power Systems Simulation Dashboard",
    "longDescription": "Verona Spark Engine desktop application providing SCADA, wind farm stability, and power systems simulation tools running natively on Windows Runtime via Microsoft WebView2.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
